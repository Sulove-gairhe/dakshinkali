{
    "name": "@dakshinkali/api",
    "version": "0.1.0",
    "private": true,
    "main": "src/app.ts",
    "scripts": {
        "dev": "nodemon --exec \"node -r dotenv/config -r tsconfig-paths/register -r ts-node/register src/server.ts\" --ext ts --watch src dotenv_config_path=../../.env",
        "build": "tsc",
        "start": "node dist/server.js",
        "lint": "eslint src --ext .ts",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "@dakshinkali/admin-mail": "workspace:*",
        "@dakshinkali/database": "workspace:*",
        "@supabase/supabase-js": "^2.105.1",
        "cors": "^2.8.5",
        "dotenv": "^16.0.3",
        "express": "^4.18.2",
        "firebase-admin": "^14.0.0",
        "jose": "^6.2.3",
        "multer": "^2.1.1",
        "swagger-ui-express": "^5.0.1",
        "yamljs": "^0.3.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.17",
        "@types/multer": "^2.1.0",
        "@types/node": "^20.0.0",
        "@types/swagger-ui-express": "^4.1.8",
        "@types/yamljs": "^0.2.34",
        "eslint": "^8.0.0",
        "nodemon": "^3.0.1",
        "ts-node": "^10.9.1",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.0.0"
    }
}