# =============================================================================
# Dakshinkali Electronics — environment variables (example only)
# Copy to .env.local (web/admin) or .env (API/scripts). Never commit real secrets.
# =============================================================================

# --- Storefront (apps/web) — safe to expose in client bundles ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: order history on /account when API is running
# NEXT_PUBLIC_API_URL=http://localhost:3002

# --- Admin UI (apps/admin) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_WEB_URL=http://localhost:3000
# NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
# NEXT_PUBLIC_API_URL=http://localhost:3002

# --- API (apps/api) — server only ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# JWT_SECRET=
# PORT=3002

# --- Scripts only (seed-auth-users, create-admin-user) — NEVER in frontend ---
# SUPABASE_SERVICE_ROLE_KEY=

# Run dev seed users (local/staging only):
#   pnpm auth:seed
