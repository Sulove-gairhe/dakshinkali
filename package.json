{
  "name": "shop-platform",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "vitest run",
    "test:integration": "vitest run apps/api/src/modules/products/__tests__/integration",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
